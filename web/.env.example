# Set to true for offline presentation without OpenRouter (counterfactual stays mock)
# Production Vercel: set to false or omit
NEXT_PUBLIC_MOCK_LLM=true

# Server shared key (optional if users bring their own key in the app)
OPENROUTER_API_KEY=

# Optional: IP rate limits per minute (defaults: server 24, user-key 40)
# LLM_RATE_LIMIT_SERVER_PER_MIN=24
# LLM_RATE_LIMIT_USER_PER_MIN=40

# Optional overrides
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
